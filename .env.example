# ==============================================================================
# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่าจริงของคุณ (ห้ามอัปโหลด .env.local ขึ้น GitHub)
# และนำค่าเหล่านี้ไปใส่ใน Environment Variables บน Vercel / Render / Railway ตอน Deploy
# ==============================================================================

# 1. ความปลอดภัยของ Session Cookie (ตั้งเป็นข้อความสุ่มยาวอย่างน้อย 32 ตัวอักษร)
SESSION_SECRET=change-this-to-a-long-random-secret-key-at-least-32-chars

# 2. บัญชีผู้ดูแลระบบและครูผู้สอนเริ่มต้น (ใช้ตอนสร้างฐานข้อมูลครั้งแรก)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=change-me-teacher-password

# 3. Firebase Admin SDK (เชื่อม Firestore ฝั่งเซิร์ฟเวอร์ — ปลอดภัย 100% ไม่หลุดไปที่เบราว์เซอร์)
# หาได้จาก Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# (หากยังไม่ได้กรอก ระบบจะทำงานด้วยฐานข้อมูลจำลองในเครื่อง data/dev-db.json ให้ทดสอบได้ทันที)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 4. Google Gemini API Key (เรียกจากฝั่งเซิร์ฟเวอร์เท่านั้น เบราว์เซอร์จะไม่มีวันเห็นคีย์)
GEMINI_API_KEY=
